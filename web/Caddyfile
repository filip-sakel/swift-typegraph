# The private proxy (SPEC §7.4): serves the client and proxies /api to the
# gateway, in plain HTTP on :4000. TLS and rate limiting are the public
# proxy's (DEPLOY.md).

{
	admin off
	auto_https off
	persist_config off
}

:4000 {
	log
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	handle /api/analyze {
		# 8 KiB of source, JSON-escaped, fits easily; the gateway checks the real limit.
		request_body {
			max_size 64KB
		}
		reverse_proxy unix//run/typegraph/gateway.sock {
			transport http {
				read_timeout 10s
			}
		}
	}

	handle /api/* {
		reverse_proxy unix//run/typegraph/gateway.sock
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header !@assets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
